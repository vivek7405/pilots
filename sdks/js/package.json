{
  "name": "@pilots/sdk",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Typed client for the pilots API: sandboxes and services on one primitive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivek7405/pilots.git",
    "directory": "sdks/js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sprites-compat": {
      "types": "./dist/sprites-compat.d.ts",
      "import": "./dist/sprites-compat.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p .",
    "test": "node --test 'test/**/*.test.ts'",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~5.9.3"
  },
  "publishConfig": { "access": "public" }
}
