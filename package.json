{
  "name": "pilots-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/dashboard",
    "apps/website",
    "packages/*",
    "sdks/js"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:hostd": "cd apps/hostd && go build ./...",
    "test:hostd": "cd apps/hostd && go test ./...",
    "vet:hostd": "cd apps/hostd && go vet ./...",
    "test:website": "npm run test:server --workspace=website",
    "test:e2e": "node scripts/e2e.mjs",
    "test:sdk-js": "npm test --workspace=sdks/js",
    "build:sdk-js": "npm run build --workspace=sdks/js",
    "vet:sdk-go": "cd sdks/go && go vet ./...",
    "test:sdk-go": "cd sdks/go && go test ./...",
    "test": "npm run vet:hostd && npm run test:hostd && npm run vet:sdk-go && npm run test:sdk-go && npm run test:sdk-js && npm run test:website && npm run test:e2e"
  }
}
