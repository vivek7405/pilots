[Unit]
Description=pilots host daemon (data plane)
Documentation=https://github.com/vivek7405/pilots
After=network-online.target
Wants=network-online.target

# Wants=, never After=, on either of these.
#
# hostd already waits up to two minutes for corrosion's schema in code
# (corrosion.WaitReady, cmd/hostd/fleet.go), so ordering on the unit buys
# nothing it does not already have. What it costs is the failure shape fly hit
# on 2026-08-13: two data-plane daemons blocked behind one another through a
# systemd dependency, so a single unit that would not settle wedged the whole
# data plane. A daemon that starts, finds its dependency absent and retries is
# strictly better than one systemd refuses to start at all.
Wants=corrosion.service pilots-mesh.service

[Service]
Type=notify
ExecStart=/opt/pilots/bin/hostd
EnvironmentFile=/etc/pilots/config
# Optional, and the '-' is what makes it optional: the cluster gate's negative
# control writes the NBD fault flags here and removes them again. Without this
# line those flags land in a file nothing reads, and the section that
# reproduces the wedge on purpose silently reproduces nothing.
EnvironmentFile=-/etc/pilots/hostd.env
Restart=always
RestartSec=1

# Restart=always catches a process that DIES. The failure it does not catch is
# the one where nothing dies: a background loop blocks on a query with no
# timeout or a socket that accepts and never answers, the process stays up,
# /v1/health answers 200, and the metering, the self-healing or the certificate
# renewal silently stops. Fly lost five hours of billing and renewal to exactly
# that on 2026-09-02 with every process healthy throughout.
#
# So hostd pets this watchdog only while every one of its loops is inside its
# budget, and withholds the pet when one is not, naming it in the journal
# first. See cmd/hostd/watchdog.go and internal/metrics/liveness.go.
#
# Safe here and nowhere else: KillMode=process below means a restart leaves the
# machines running to be re-adopted, so the cost is a few seconds of API rather
# than an outage. corrosion.service has carried the same line since 2024.
WatchdogSec=30

# Type=notify plus that 120s schema wait needs a start timeout above it, or
# systemd SIGKILLs a perfectly healthy hostd at the 90s default -- during
# exactly the fleet-wide restart where the wait is longest.
TimeoutStartSec=180

# hostd spawns firecracker and the uffd/NBD handlers, and creates cgroup v2
# sub-slices per guest -- Delegate=yes is what makes that legal.
Delegate=yes

# Kill ONLY the daemon, never its machines. systemd's default (control-group)
# would SIGTERM every Firecracker in hostd's cgroup on a restart, turning a
# routine daemon upgrade into an outage for every workload on the host. hostd
# re-adopts the running machines on its next start.
KillMode=process

# Long-lived FC API sockets, exec streams and per-VM handlers add up fast; the
# predecessor wedged hosts by exhausting file descriptors.
LimitNOFILE=65536
LimitMEMLOCK=infinity

# Must exceed hostd's own 30s bounded shutdown so systemd never SIGKILLs a
# host that is still tearing guests down cleanly.
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
