# The dashboard's environment. Copy to .env and fill in:  cp .env.example .env
#
# `env.ts` validates every one of these at boot and fails naming each bad
# variable, so a misconfigured dashboard refuses to start rather than answering
# 502 on every page. README.md explains where each value comes from.

# ── Server ──────────────────────────────────────────────────────────
PORT=8080

# ── Session signing ─────────────────────────────────────────────────
# 32+ random characters. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A guessable value means forgeable sessions, and this app mints fleet keys.
AUTH_SECRET=

# ── The GitHub App ──────────────────────────────────────────────────
# The client id and secret of the ONE App that serves this dashboard's login,
# the CLI's device flow and the engine's webhook. See README.md to register it.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional. Without these, installation state renders as "App not configured on
# this fleet" and connecting a repo still works, because the ENGINE acts on a
# push. `PILOT_GITHUB_APP_KEY` takes the PEM itself or a path to it.
# PILOT_GITHUB_APP_ID=
# PILOT_GITHUB_APP_KEY=
# PILOT_GITHUB_APP_SLUG=pilots

# ── The fleet ───────────────────────────────────────────────────────
# An admin-scoped key. In production this arrives as sealed secret_env; see
# README.md for the bootstrap and rotation procedure.
PILOT_ADMIN_KEY=

# REQUIRED, with no default: the fleet's API hostname, OFF the workload apex.
# The dashboard is a guest and reaches hostd over this public address, never
# over loopback and never over fdcc::.
PILOT_API_URL=

# ── Database ────────────────────────────────────────────────────────
# Locally a file in db/. In production `file:/data/dev.db`, on the volume, so it
# survives every redeploy and every restore from a release snapshot.
DATABASE_URL=file:./db/dev.db

# ── The usage poller ────────────────────────────────────────────────
# Runs only when NODE_ENV=production. Set to 0 to disable it there too.
# PILOT_USAGE_POLL=0
