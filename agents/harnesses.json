[
  {
    "name": "claude-code",
    "title": "Claude Code",
    "user": "~/.claude.json",
    "project": ".mcp.json",
    "format": "json",
    "path": ["mcpServers", "pilots"],
    "http": { "type": "http", "url": "$URL", "headers": { "Authorization": "Bearer $KEY" } },
    "stdio": { "type": "stdio", "command": "pilot", "args": ["mcp"] },
    "after": [
      "Or install the plugin, which adds the skill, /pilots:status, /pilots:smoke and a guard that asks before a destructive call:",
      "  /plugin marketplace add vivek7405/pilots",
      "  /plugin install pilots@pilots"
    ],
    "verify": "/mcp, then ask: list my machines"
  },
  {
    "name": "codex",
    "title": "Codex",
    "user": "~/.codex/config.toml",
    "project": ".codex/config.toml",
    "format": "toml",
    "path": ["mcp_servers", "pilots"],
    "http": { "url": "$URL", "http_headers": { "Authorization": "Bearer $KEY" } },
    "stdio": { "command": "pilot", "args": ["mcp"] },
    "verify": "restart codex, then ask: list my machines"
  },
  {
    "name": "cursor",
    "title": "Cursor",
    "user": "~/.cursor/mcp.json",
    "project": ".cursor/mcp.json",
    "format": "json",
    "path": ["mcpServers", "pilots"],
    "http": { "url": "$URL", "headers": { "Authorization": "Bearer $KEY" } },
    "stdio": { "command": "pilot", "args": ["mcp"] },
    "verify": "Settings > MCP shows pilots with a green dot"
  },
  {
    "name": "opencode",
    "title": "OpenCode",
    "user": "~/.config/opencode/opencode.json",
    "project": "opencode.json",
    "format": "json",
    "path": ["mcp", "pilots"],
    "http": { "type": "remote", "url": "$URL", "headers": { "Authorization": "Bearer $KEY" }, "enabled": true },
    "stdio": { "type": "local", "command": ["pilot", "mcp"], "enabled": true },
    "verify": "opencode mcp list"
  },
  {
    "name": "windsurf",
    "title": "Windsurf",
    "user": "~/.codeium/windsurf/mcp_config.json",
    "format": "json",
    "path": ["mcpServers", "pilots"],
    "http": { "serverUrl": "$URL", "headers": { "Authorization": "Bearer $KEY" } },
    "stdio": { "command": "pilot", "args": ["mcp"] },
    "verify": "Cascade > MCP servers shows pilots"
  },
  {
    "name": "gemini",
    "title": "Gemini CLI",
    "user": "~/.gemini/settings.json",
    "project": ".gemini/settings.json",
    "format": "json",
    "path": ["mcpServers", "pilots"],
    "http": { "httpUrl": "$URL", "headers": { "Authorization": "Bearer $KEY" } },
    "stdio": { "command": "pilot", "args": ["mcp"] },
    "verify": "/mcp inside gemini"
  },
  {
    "name": "vscode",
    "title": "VS Code (Copilot)",
    "user": "~/.config/Code/User/mcp.json",
    "user_darwin": "~/Library/Application Support/Code/User/mcp.json",
    "project": ".vscode/mcp.json",
    "format": "json",
    "path": ["servers", "pilots"],
    "http": { "type": "http", "url": "$URL", "headers": { "Authorization": "Bearer $KEY" } },
    "stdio": { "type": "stdio", "command": "pilot", "args": ["mcp"] },
    "verify": "MCP: List Servers in the command palette"
  },
  {
    "name": "zed",
    "title": "Zed",
    "user": "~/.config/zed/settings.json",
    "project": ".zed/settings.json",
    "format": "json",
    "path": ["context_servers", "pilots"],
    "stdio": { "source": "custom", "command": "pilot", "args": ["mcp"] },
    "verify": "Agent panel > settings shows pilots"
  },
  {
    "name": "claude-desktop",
    "title": "Claude Desktop",
    "user": "~/.config/Claude/claude_desktop_config.json",
    "user_darwin": "~/Library/Application Support/Claude/claude_desktop_config.json",
    "format": "json",
    "path": ["mcpServers", "pilots"],
    "stdio": { "command": "pilot", "args": ["mcp"] },
    "verify": "restart Claude Desktop; the tools icon lists pilots"
  },
  {
    "name": "generic",
    "title": "Any MCP client",
    "project": "mcp.json",
    "format": "json",
    "path": ["mcpServers", "pilots"],
    "http": { "type": "http", "url": "$URL", "headers": { "Authorization": "Bearer $KEY" } },
    "stdio": { "type": "stdio", "command": "pilot", "args": ["mcp"] },
    "verify": "point the client at the file, or paste the entry into its own"
  }
]
