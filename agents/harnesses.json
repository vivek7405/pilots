    "user": "~/.codex/config.toml",
    "project": ".codex/config.toml",
    "format": "toml",
    "path": ["mcp_servers", "pilots"],
    "http": { "url": "$URL", "bearer_token_env_var": "$KEYENV" },
    "stdio": { "command": "pilot", "args": ["mcp"] },
    "after": [
      "Codex reads the token from the environment rather than the file, so the config carries no secret:",
      "  export PILOT_API_KEY=<your token>"
    ],
    "verify": "codex mcp list",
    "source": "codex mcp add --help (codex-cli 0.153.0), confirmed by writing an entry and reading it back",
    "checked": "2026-09-11"
  },
